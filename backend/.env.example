# Provider credentials: keep these on the backend only.
AI_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=false
DEEPSEEK_MAX_OUTPUT_TOKENS=256
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BASE_MS=250

AI_STT_PROVIDER=gemini
AI_TTS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Independent credential used by the ESP32 in Authorization: Bearer <token>.
# Generate at least 32 random bytes. Do not reuse GEMINI_API_KEY.
ESP_DEVICE_TOKEN=

HOST=127.0.0.1
PORT=8787
REQUEST_TIMEOUT_MS=45000
MAX_QUERY_BYTES=400000
MAX_TEXT_BYTES=511
MAX_CONCURRENT_REQUESTS=4

# Optional extra TTS request immediately after /v1/query. Disabled to avoid
# duplicate provider cost when the device never asks for /v1/tts.
TTS_PREWARM_ENABLED=false

# IDs must match AI_MUSIC_STREAM_SOURCES_JSON in include/secrets.h.
# URLs never come from a model and are never returned to the ESP32 action parser.
MUSIC_SOURCES_JSON=[]
# Example:
# MUSIC_SOURCES_JSON=[{"id":"radio1","label":"Radio 1","url":"https://radio.example/live.mp3"}]
