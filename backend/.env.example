# YouTube Audio Proxy – Cấu hình môi trường

HOST=127.0.0.1
PORT=8787

# Bắt buộc khi HOST không phải loopback. Firmware dùng cùng giá trị.
PROXY_USER=
PROXY_PASSWORD=
MAX_STREAMS=2
STREAM_IDLE_TIMEOUT_MS=30000

# Đường dẫn tuyệt đối tới yt-dlp (tuỳ chọn – để trống sẽ tự dò trong PATH)
YT_DLP_PATH=
