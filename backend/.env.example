# Provider credential: keep this on the backend only.
GEMINI_API_KEY=
GEMINI_QUERY_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Independent credential used by the ESP32 in Authorization: Bearer <token>.
# Generate at least 32 random bytes. Do not reuse GEMINI_API_KEY.
ESP_DEVICE_TOKEN=

HOST=127.0.0.1
PORT=8787
REQUEST_TIMEOUT_MS=45000
MAX_QUERY_BYTES=400000
MAX_TEXT_BYTES=511

# IDs must match AI_MUSIC_STREAM_SOURCES_JSON in include/secrets.h.
# URLs never come from Gemini and are never returned to the ESP32 action parser.
MUSIC_SOURCES_JSON=[]
# Example:
# MUSIC_SOURCES_JSON=[{"id":"radio1","label":"Radio 1","url":"https://radio.example/live.mp3"}]
