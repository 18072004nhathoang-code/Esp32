<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ESP32-S3 2.8" Touch Display Mini OS Simulator</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            user-select: none;
        }

        body {
            background: linear-gradient(135deg, #0d1117 0%, #161b22 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #c9d1d9;
            padding: 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 20px;
        }

        .header h1 {
            font-size: 22px;
            color: #58a6ff;
            margin-bottom: 6px;
        }

        .header p {
            font-size: 13px;
            color: #8b949e;
        }

        /* Khung bo mạch ESP32-S3 2.8" (Yellow Board Mockup) */
        .board-frame {
            background: #d4ac0d;
            border-radius: 20px;
            padding: 24px 28px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), inset 0 2px 4px rgba(255, 255, 255, 0.4);
            border: 2px solid #b7950b;
            position: relative;
        }

        .board-pin-header-top, .board-pin-header-bottom {
            display: flex;
            justify-content: space-between;
            padding: 0 10px;
        }

        .pin-dot {
            width: 7px;
            height: 7px;
            background: #444;
            border: 1.5px solid #dcdcdc;
            border-radius: 50%;
            display: inline-block;
            margin: 0 4px;
        }

        .board-label {
            font-size: 10px;
            font-weight: 700;
            color: #333;
            letter-spacing: 1px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .led-indicator {
            width: 8px;
            height: 8px;
            background: #2ecc71;
            border-radius: 50%;
            box-shadow: 0 0 8px #2ecc71;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.85); }
        }

        /* Màn hình TFT 2.8" tỷ lệ chuẩn (320x240 phóng to 2x thành 640x480) */
        .display-bezel {
            background: #000;
            padding: 8px;
            border-radius: 10px;
            box-shadow: inset 0 3px 6px rgba(0, 0, 0, 0.9), 0 2px 4px rgba(255, 255, 255, 0.2);
        }

        .lcd-screen {
            width: 640px;
            height: 480px;
            background: #0f1117;
            border-radius: 4px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: filter 0.2s ease;
        }

        /* Status Bar (320x24px scale x2 = 640x48px) */
        .status-bar {
            height: 48px;
            background: #181a20;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 16px;
            font-size: 18px;
            font-weight: 600;
            border-bottom: 1px solid #232730;
            z-index: 10;
        }

        .os-logo {
            color: #00d2ff;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .os-clock {
            color: #ffffff;
            font-family: monospace;
            font-size: 20px;
        }

        .os-stats {
            color: #27ae60;
            font-size: 16px;
        }

        /* Desktop Workspace (640x432px) */
        .desktop {
            flex: 1;
            padding: 16px 20px;
            overflow-y: auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            background: #0f1117;
        }

        .app-tile {
            background: #22262f;
            border-radius: 16px;
            height: 120px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: transform 0.15s, box-shadow 0.15s;
            border: 2px solid transparent;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.4);
        }

        .app-tile:hover {
            transform: translateY(-2px);
        }

        .app-tile:active {
            transform: scale(0.96);
        }

        .app-tile.system { border-color: #00d2ff; }
        .app-tile.maps   { border-color: #ea4335; }
        .app-tile.settings { border-color: #f39c12; }
        .app-tile.wifi   { border-color: #2ecc71; }
        .app-tile.about  { border-color: #9b59b6; }

        .tile-icon {
            font-size: 38px;
        }

        .tile-title {
            font-size: 16px;
            font-weight: 600;
            color: #ecf0f1;
        }

        /* Modal App Window */
        .app-window {
            position: absolute;
            top: 48px;
            left: 0;
            right: 0;
            bottom: 0;
            background: #141824;
            display: none;
            flex-direction: column;
            z-index: 20;
        }

        .app-window.active {
            display: flex;
        }

        .app-header {
            height: 48px;
            background: #1f2433;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 14px;
            border-bottom: 1px solid #2d3446;
        }

        .app-header-title {
            font-size: 18px;
            font-weight: 600;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .app-close-btn {
            background: #e74c3c;
            color: #fff;
            border: none;
            width: 44px;
            height: 32px;
            border-radius: 6px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .app-close-btn:active {
            background: #c0392b;
        }

        .app-body {
            flex: 1;
            padding: 16px;
            overflow-y: auto;
        }

        /* Map App Layout */
        .map-container {
            display: flex;
            gap: 12px;
            height: 320px;
        }

        #mapCanvas {
            width: 460px;
            height: 320px;
            background: #212a37;
            border-radius: 8px;
            border: 2px solid #3b4a5a;
        }

        .map-toolbar {
            width: 140px;
            background: #1b212d;
            border-radius: 8px;
            padding: 8px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            align-items: center;
        }

        .btn-row {
            display: flex;
            gap: 6px;
            width: 100%;
        }

        .tool-btn {
            background: #34495e;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            flex: 1;
            text-align: center;
        }

        .tool-btn:active {
            background: #2c3e50;
        }

        .tool-btn.primary { background: #2980b9; }
        .tool-btn.accent  { background: #e67e22; }
        .tool-btn.success { background: #27ae60; }

        .d-pad {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 4px;
            width: 100%;
            margin: 4px 0;
        }

        .d-pad button {
            background: #34495e;
            border: none;
            color: #fff;
            padding: 8px 0;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .d-pad button:active {
            background: #1abc9c;
        }

        .map-footer {
            margin-top: 10px;
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            color: #bdc3c7;
            background: #181d29;
            padding: 8px 12px;
            border-radius: 6px;
        }

        .city-tag {
            color: #f39c12;
            font-weight: bold;
        }

        /* Progress Bar for System Monitor */
        .stat-group {
            margin-bottom: 16px;
        }

        .stat-label {
            display: flex;
            justify-content: space-between;
            font-size: 15px;
            margin-bottom: 6px;
        }

        .progress-track {
            height: 18px;
            background: #22262f;
            border-radius: 9px;
            overflow: hidden;
            border: 1px solid #3b4252;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #00d2ff, #0084ff);
            border-radius: 9px;
            transition: width 0.4s ease;
        }

        .progress-fill.green {
            background: linear-gradient(90deg, #2ecc71, #27ae60);
        }

        /* Settings Range */
        .setting-slider {
            width: 100%;
            margin: 16px 0;
            accent-color: #f39c12;
            cursor: pointer;
        }

        /* Touch Pointer Marker */
        .touch-point {
            position: absolute;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: rgba(0, 210, 255, 0.4);
            border: 2px solid #00d2ff;
            pointer-events: none;
            transform: translate(-50%, -50%);
            display: none;
            z-index: 99;
        }

        .instructions {
            margin-top: 20px;
            text-align: center;
            max-width: 640px;
            font-size: 13px;
            color: #8b949e;
            line-height: 1.6;
        }

        .instructions code {
            background: #21262d;
            padding: 2px 6px;
            border-radius: 4px;
            color: #58a6ff;
        }
    </style>
</head>
<body>

    <div class="header">
        <h1>⚡ ESP32-S3 2.8" Touch Display Mini OS Simulator</h1>
        <p>Mô phỏng 1:1 giao diện LVGL 8.3 + LovyanGFX độ phân giải 320x240 (Phóng to 2x)</p>
    </div>

    <!-- Khung bo mạch phần cứng -->
    <div class="board-frame">
        <div class="board-label">
            <span>ESP32-S3-2432S028 TOUCH LCD</span>
            <div style="display:flex; align-items:center; gap:8px;">
                <span>PWR / RUN</span>
                <div class="led-indicator"></div>
            </div>
        </div>

        <div class="display-bezel">
            <div class="lcd-screen" id="lcdScreen">
                
                <!-- Touch Ripple Cursor -->
                <div class="touch-point" id="touchPoint"></div>

                <!-- 1. Top Status Bar -->
                <div class="status-bar">
                    <div class="os-logo">▶ S3-OS</div>
                    <div class="os-clock" id="clockText">00:00:00</div>
                    <div class="os-stats" id="ramText">RAM 28%</div>
                </div>

                <!-- 2. Desktop Launcher -->
                <div class="desktop" id="desktopView">
                    <div class="app-tile system" onclick="openApp('system')">
                        <div class="tile-icon" style="color: #00d2ff;">⚡</div>
                        <div class="tile-title">System</div>
                    </div>
                    <div class="app-tile maps" onclick="openApp('maps')">
                        <div class="tile-icon" style="color: #ea4335;">📍</div>
                        <div class="tile-title">Google Maps</div>
                    </div>
                    <div class="app-tile settings" onclick="openApp('settings')">
                        <div class="tile-icon" style="color: #f39c12;">⚙️</div>
                        <div class="tile-title">Settings</div>
                    </div>
                    <div class="app-tile wifi" onclick="openApp('wifi')">
                        <div class="tile-icon" style="color: #2ecc71;">📶</div>
                        <div class="tile-title">WiFi</div>
                    </div>
                    <div class="app-tile about" onclick="openApp('about')">
                        <div class="tile-icon" style="color: #9b59b6;">📄</div>
                        <div class="tile-title">About</div>
                    </div>
                </div>

                <!-- 3. Modal App Windows -->
                <!-- A. Google Maps Window -->
                <div class="app-window" id="app_maps">
                    <div class="app-header">
                        <div class="app-header-title">📍 Google Maps Viewer</div>
                        <button class="app-close-btn" onclick="closeApp()">✕</button>
                    </div>
                    <div class="app-body">
                        <div class="map-container">
                            <canvas id="mapCanvas" width="460" height="320"></canvas>
                            <div class="map-toolbar">
                                <div class="btn-row">
                                    <button class="tool-btn primary" onclick="zoomMap(1)">➕</button>
                                    <button class="tool-btn primary" onclick="zoomMap(-1)">➖</button>
                                </div>
                                <div class="d-pad">
                                    <div></div>
                                    <button onclick="panMap(0, 1)">▲</button>
                                    <div></div>
                                    <button onclick="panMap(-1, 0)">◀</button>
                                    <div></div>
                                    <button onclick="panMap(1, 0)">▶</button>
                                    <div></div>
                                    <button onclick="panMap(0, -1)">▼</button>
                                    <div></div>
                                </div>
                                <button class="tool-btn accent" style="width:100%;" onclick="nextCity()">📍 City</button>
                                <button class="tool-btn success" style="width:100%;" id="netBtn" onclick="toggleNet()">🌐 Net</button>
                            </div>
                        </div>
                        <div class="map-footer">
                            <div><span class="city-tag" id="cityText">Hà Nội (Hồ Gươm)</span> | <span id="coordText">Lat: 21.0285 | Lon: 105.8542 | Z14</span></div>
                            <div id="netStatus" style="color: #2ecc71;">Offline Vector Engine</div>
                        </div>
                    </div>
                </div>

                <!-- B. System Monitor Window -->
                <div class="app-window" id="app_system">
                    <div class="app-header">
                        <div class="app-header-title">⚡ System Monitor</div>
                        <button class="app-close-btn" onclick="closeApp()">✕</button>
                    </div>
                    <div class="app-body">
                        <div class="stat-group">
                            <div class="stat-label"><span>SRAM (Heap)</span><span id="sramVal" style="color:#00d2ff;">142 / 512 KB (28%)</span></div>
                            <div class="progress-track"><div class="progress-fill" id="sramBar" style="width: 28%;"></div></div>
                        </div>
                        <div class="stat-group">
                            <div class="stat-label"><span>PSRAM (Octal)</span><span id="psramVal" style="color:#2ecc71;">1.1 / 8.0 MB (14%)</span></div>
                            <div class="progress-track"><div class="progress-fill green" id="psramBar" style="width: 14%;"></div></div>
                        </div>
                        <div style="font-size:15px; line-height:2; color:#cbd5e1; margin-top:14px;">
                            <div>CPU Frequency: <b>240 MHz (Dual Core)</b></div>
                            <div>Chip Temperature: <b id="tempVal" style="color:#f39c12;">41.8 °C</b></div>
                            <div>Flash Chip: <b>16 MB (Quad QIO 80MHz)</b></div>
                            <div>Graphic Driver: <b>LovyanGFX Hardware DMA @ 40MHz</b></div>
                        </div>
                    </div>
                </div>

                <!-- C. Settings Window -->
                <div class="app-window" id="app_settings">
                    <div class="app-header">
                        <div class="app-header-title">⚙️ Cài đặt hệ thống</div>
                        <button class="app-close-btn" onclick="closeApp()">✕</button>
                    </div>
                    <div class="app-body">
                        <div style="font-size:16px; margin-bottom:10px;">Độ sáng đèn nền (PWM Backlight): <b id="brightVal" style="color:#f39c12;">85%</b></div>
                        <input type="range" class="setting-slider" min="15" max="100" value="85" oninput="changeBrightness(this.value)">
                        <div style="margin-top:20px; font-size:14px; color:#8b949e; line-height:1.8;">
                            <div>• Tần số PWM: 44.1 kHz (Kênh 7)</div>
                            <div>• Tần số quét khung hình: ~60 FPS</div>
                            <div>• Theme đồ họa: LVGL 8 Dark Mode</div>
                        </div>
                    </div>
                </div>

                <!-- D. WiFi Window -->
                <div class="app-window" id="app_wifi">
                    <div class="app-header">
                        <div class="app-header-title">📶 WiFi Manager</div>
                        <button class="app-close-btn" onclick="closeApp()">✕</button>
                    </div>
                    <div class="app-body" style="text-align:center; padding-top:40px;">
                        <div style="font-size:20px; margin-bottom:12px;">Chế độ WiFi: STA / AP</div>
                        <p style="color:#8b949e; font-size:14px; margin-bottom:24px;">Bo mạch sẵn sàng kết nối vào mạng 2.4GHz để tải bản đồ trực tuyến.</p>
                        <button class="tool-btn primary" style="width:200px; margin:0 auto; padding:12px;" onclick="alert('Đang quét mạng WiFi xung quanh...')">🔄 Quét mạng WiFi</button>
                    </div>
                </div>

                <!-- E. About Window -->
                <div class="app-window" id="app_about">
                    <div class="app-header">
                        <div class="app-header-title">📄 Thông tin Mini OS</div>
                        <button class="app-close-btn" onclick="closeApp()">✕</button>
                    </div>
                    <div class="app-body" style="line-height: 2; font-size: 15px;">
                        <div>• <b>Hệ thống:</b> ESP32-S3 Mini OS v1.0</div>
                        <div>• <b>Đồ họa:</b> LVGL v8.3.11</div>
                        <div>• <b>Driver tăng tốc:</b> LovyanGFX v1.1.16</div>
                        <div>• <b>Bộ đệm:</b> Double DMA Buffer (Internal SRAM)</div>
                        <div>• <b>Bản đồ:</b> Google Maps Dual-Engine (PSRAM Canvas)</div>
                        <div>• <b>Môi trường:</b> VS Code + PlatformIO</div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="instructions">
        <p>💡 Bạn có thể dùng chuột hoặc chạm màn hình để mở các ứng dụng, điều khiển thanh trượt độ sáng, di chuyển bản đồ hoặc đổi thành phố trên bản mô phỏng.</p>
        <p>Để nạp trực tiếp vào mạch thực tế: Mở VS Code -> Nhấn <code>Build (✓)</code> -> <code>Upload (→)</code> vào cổng <code>COM3</code>.</p>
    </div>

    <script>
        // Đồng hồ hệ thống
        let startTime = Date.now();
        function updateClock() {
            let elapsed = Math.floor((Date.now() - startTime) / 1000);
            let h = String(Math.floor(elapsed / 3600)).padStart(2, '0');
            let m = String(Math.floor((elapsed % 3600) / 60)).padStart(2, '0');
            let s = String(elapsed % 60).padStart(2, '0');
            document.getElementById('clockText').innerText = `${h}:${m}:${s}`;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Quản lý đóng mở App
        function openApp(appId) {
            document.getElementById('desktopView').style.display = 'none';
            document.querySelectorAll('.app-window').forEach(w => w.classList.remove('active'));
            let win = document.getElementById('app_' + appId);
            if (win) win.classList.add('active');
            if (appId === 'maps') renderMap();
        }

        function closeApp() {
            document.querySelectorAll('.app-window').forEach(w => w.classList.remove('active'));
            document.getElementById('desktopView').style.display = 'grid';
        }

        // Điều chỉnh độ sáng màn hình mô phỏng
        function changeBrightness(val) {
            document.getElementById('brightVal').innerText = val + '%';
            let opacity = 0.3 + (val / 100) * 0.7;
            document.getElementById('lcdScreen').style.filter = `brightness(${opacity})`;
        }

        // Touch Cursor Ripple
        const lcd = document.getElementById('lcdScreen');
        const touchPoint = document.getElementById('touchPoint');
        lcd.addEventListener('pointerdown', (e) => {
            const rect = lcd.getBoundingClientRect();
            touchPoint.style.left = (e.clientX - rect.left) + 'px';
            touchPoint.style.top = (e.clientY - rect.top) + 'px';
            touchPoint.style.display = 'block';
            setTimeout(() => { touchPoint.style.display = 'none'; }, 250);
        });

        // BẢN ĐỒ GOOGLE MAPS ENGINE
        const cities = [
            { name: "Hà Nội (Hồ Gươm)", lat: 21.0285, lon: 105.8542, z: 14 },
            { name: "TP.HCM (Chợ Bến Thành)", lat: 10.7725, lon: 106.6980, z: 14 },
            { name: "Đà Nẵng (Cầu Rồng)", lat: 16.0611, lon: 108.2274, z: 14 },
            { name: "Tokyo (Shibuya)", lat: 35.6595, lon: 139.7005, z: 15 },
            { name: "Paris (Tháp Eiffel)", lat: 48.8584, 2.2945, z: 15 },
            { name: "New York (Times Sq)", lat: 40.7580, -73.9855, z: 14 }
        ];
        let cityIdx = 0;
        let curLat = cities[0].lat;
        let curLon = cities[0].lon;
        let curZoom = cities[0].z;
        let isOnline = false;

        const canvas = document.getElementById('mapCanvas');
        const ctx = canvas.getContext('2d');

        function renderMap() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Nền đất Google Maps Dark (#212a37)
            ctx.fillStyle = "#212a37";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            let scale = Math.pow(2, Math.max(1, curZoom - 10));
            let offsetX = Math.floor(curLon * 200 * scale) % 60;
            let offsetY = Math.floor(curLat * 200 * scale) % 60;

            // 1. Công viên cây xanh (#1e3835)
            ctx.fillStyle = "#1e3835";
            ctx.fillRect((offsetX + 40) % canvas.width, 30, 120, 90);
            ctx.fillRect((offsetX + 250) % canvas.width, 170, 100, 80);

            // 2. Sông hồ mặt nước (#16263d)
            ctx.fillStyle = "#16263d";
            ctx.beginPath();
            for (let y = 0; y < canvas.height; y += 4) {
                let rx = Math.sin((y + offsetY * 3) * 0.03) * 30 + (canvas.width / 2) + offsetX - 50;
                ctx.rect(rx, y, 32, 4);
            }
            ctx.fill();

            // 3. Đường nội đô (#323b49)
            ctx.strokeStyle = "#323b49";
            ctx.lineWidth = 3;
            for (let x = offsetX; x < canvas.width; x += 60) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, canvas.height);
                ctx.stroke();
            }
            for (let y = offsetY; y < canvas.height; y += 60) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(canvas.width, y);
                ctx.stroke();
            }

            // 4. Cao tốc huyết mạch cam Google Maps (#e58e26)
            ctx.strokeStyle = "#e58e26";
            ctx.lineWidth = 6;
            ctx.beginPath();
            let hy = (canvas.height / 2) + (offsetY % 40) - 20;
            ctx.moveTo(0, hy);
            ctx.lineTo(canvas.width, hy + 30);
            ctx.stroke();

            // Đại lộ xanh (#3867d6)
            ctx.strokeStyle = "#3867d6";
            ctx.lineWidth = 5;
            ctx.beginPath();
            let hx = (canvas.width / 3) + (offsetX % 60) - 30;
            ctx.moveTo(hx, 0);
            ctx.lineTo(hx + 50, canvas.height);
            ctx.stroke();

            // 5. Tâm ghim vị trí đỏ Google Maps (#ea4335)
            let cx = canvas.width / 2;
            let cy = canvas.height / 2;

            // Bóng đổ
            ctx.fillStyle = "rgba(0,0,0,0.5)";
            ctx.beginPath();
            ctx.ellipse(cx, cy + 4, 8, 4, 0, 0, Math.PI * 2);
            ctx.fill();

            // Ghim đỏ
            ctx.fillStyle = "#ea4335";
            ctx.beginPath();
            ctx.arc(cx, cy - 12, 12, 0, Math.PI * 2);
            ctx.fill();

            ctx.beginPath();
            ctx.moveTo(cx - 7, cy - 8);
            ctx.lineTo(cx, cy);
            ctx.lineTo(cx + 7, cy - 8);
            ctx.fill();

            // Tâm trắng trong ghim
            ctx.fillStyle = "#ffffff";
            ctx.beginPath();
            ctx.arc(cx, cy - 12, 4, 0, Math.PI * 2);
            ctx.fill();

            // 6. La bàn góc trên phải
            ctx.fillStyle = "#2c3a47";
            ctx.beginPath();
            ctx.arc(canvas.width - 24, 24, 16, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = "#ea4335";
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(canvas.width - 24, 24);
            ctx.lineTo(canvas.width - 24, 12);
            ctx.stroke();

            // Cập nhật text
            document.getElementById('cityText').innerText = cities[cityIdx].name;
            document.getElementById('coordText').innerText = `Lat: ${curLat.toFixed(4)} | Lon: ${curLon.toFixed(4)} | Z${curZoom}`;
        }

        function zoomMap(delta) {
            curZoom = Math.min(19, Math.max(5, curZoom + delta));
            renderMap();
        }

        function panMap(dx, dy) {
            let step = 0.01 / Math.pow(2, Math.max(0, curZoom - 12));
            curLon += dx * step;
            curLat += dy * step;
            renderMap();
        }

        function nextCity() {
            cityIdx = (cityIdx + 1) % cities.length;
            curLat = cities[cityIdx].lat;
            curLon = cities[cityIdx].lon;
            curZoom = cities[cityIdx].z;
            renderMap();
        }

        function toggleNet() {
            isOnline = !isOnline;
            document.getElementById('netStatus').innerText = isOnline ? "Online 4G/WiFi Active" : "Offline Vector Engine";
            document.getElementById('netStatus').style.color = isOnline ? "#00d2ff" : "#2ecc71";
            renderMap();
        }

        // Khởi động bản đồ
        renderMap();
    </script>
</body>
</html>
